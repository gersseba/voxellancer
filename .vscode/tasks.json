{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "start game",
            "type": "process",
            "command": "cmake",
            "args": [
                "-DMODE=Run",
                "-DRUN=LocalServer",
                "-P",
                "${workspaceFolder}/tools/agent-check.cmake"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc",
                "$msCompile"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}

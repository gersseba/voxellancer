{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "AI Dogfight Comparison (macOS)",
            "type": "shell",
            "command": "cmake --build build/macos --target voxellancer && ./build/macos/voxellancer -scenario ai-comparison -nointro",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Play Contracts with Local Server (macOS)",
            "type": "process",
            "command": "/bin/bash",
            "args": [
                "${workspaceFolder}/tools/run-local-macos.sh",
                "-scenario",
                "contracts",
                "-nointro"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Start Client with Local Server (macOS)",
            "type": "process",
            "command": "/bin/bash",
            "args": [
                "${workspaceFolder}/tools/run-local-macos.sh"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Start Server",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\tools\\agent-check.ps1",
                "-Mode",
                "Run",
                "-Benchmark",
                "StartServer"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Start Client",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\tools\\agent-check.ps1",
                "-Mode",
                "Run",
                "-Benchmark",
                "StartClient"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Start Shield Showcase Scenario",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\tools\\agent-check.ps1",
                "-Mode",
                "Run",
                "-Scenario",
                "ShieldShowcase"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Start Local Client with Integrated Server (Large Combat Benchmark)",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\tools\\agent-check.ps1",
                "-Mode",
                "Run",
                "-Benchmark",
                "LocalLargeCombat"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Start Server and Two Clients (Large Combat Benchmark)",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\tools\\agent-check.ps1",
                "-Mode",
                "Run",
                "-Benchmark",
                "MultiplayerLargeCombat"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}

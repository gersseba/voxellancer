{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Tests",
            "type": "process",
            "command": "cmake",
            "args": [
                "-P",
                "${workspaceFolder}/tools/agent-check.cmake"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc",
                "$msCompile"
            ],
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Start Server",
            "type": "process",
            "command": "cmake",
            "args": [
                "-DMODE=Run",
                "-DRUN=StartServer",
                "-P",
                "${workspaceFolder}/tools/agent-check.cmake"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc",
                "$msCompile"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
